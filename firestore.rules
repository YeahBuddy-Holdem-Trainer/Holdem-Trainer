rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can read and write only the data under their own account: users/{their uid}/...
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Flags: anyone signed in can send one (in their own name, size-limited).
    // Only admins can read, resolve or delete them.
    match /flags/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'view', 'title', 'game', 'note', 'text', 'state', 'version', 'ts', 'status'])
        && request.resource.data.note is string && request.resource.data.note.size() <= 1500
        && request.resource.data.text is string && request.resource.data.text.size() <= 8000
        && request.resource.data.state is string && request.resource.data.state.size() <= 12000;
      allow read, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins: a document named with the admin's user ID, added by hand in the Firebase console.
    // People can only check whether they themselves are an admin; nobody can add themselves.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // App-wide settings (the clocks): anyone can read them; only admins can change them.
    match /config/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['shot', 'bankOn', 'bank', 'fhOn', 'fhShot', 'ts'])
        && request.resource.data.shot is int && request.resource.data.shot >= 5 && request.resource.data.shot <= 120
        && request.resource.data.bank is int && request.resource.data.bank >= 5 && request.resource.data.bank <= 300
        && request.resource.data.fhShot is int && request.resource.data.fhShot >= 5 && request.resource.data.fhShot <= 180
        && request.resource.data.bankOn is bool && request.resource.data.fhOn is bool;
    }
    // Everything else is closed.
  }
}
